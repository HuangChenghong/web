# ============================================================
# 环境变量模板 · 复制成 .env 后填实际值
# 用法：cp .env.example .env  然后 nano .env
# ⚠️ .env 不要提交到 Git！
# ============================================================

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=改成强密码_root_abc123
DB_NAME=myapp
DB_USER=myapp_user
DB_PASSWORD=改成强密码_db_xyz789

# ---- Redis ----
REDIS_PASSWORD=改成强密码_redis_qwe456

# ---- 后端业务配置 ----
JWT_SECRET=随便生成一串长字符串_比如_uuid_or_random
# 如果你后端还有其他配置，比如：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=xxx@qq.com
# SMTP_PASS=授权码
